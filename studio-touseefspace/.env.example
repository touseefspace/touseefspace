# ==========================================
# Sanity Studio — Environment Variables Template
# Copy this file to .env.local: cp .env.example .env.local
# ==========================================

# 1. Project & Dataset Configuration
SANITY_STUDIO_PROJECT_ID="your_sanity_project_id"
SANITY_STUDIO_DATASET="development"

# 2. Studio Hosting & Deployment (for 'npx sanity deploy')
SANITY_STUDIO_HOST="your-studio-subdomain"
SANITY_STUDIO_APP_ID=""

# 3. Sanity Write Token (Required for automated seeding: npm run seed)
SANITY_TOKEN=""
