# ==========================================
# touseefspace — Environment Variables Template
# Copy this file to .env.local or .env
# ==========================================

# 1. Sanity CMS Configuration (Public)
# Get these from your Sanity project dashboard: https://sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID="your_sanity_project_id"
NEXT_PUBLIC_SANITY_DATASET="production"
NEXT_PUBLIC_SANITY_API_VERSION="2026-02-01"

# 2. Sanity API Read Token & Webhook Secret (for Instant Revalidation & Live Preview)
# Requires Viewer token with read access: https://sanity.io/manage
SANITY_API_READ_TOKEN=""
SANITY_REVALIDATE_SECRET="generate_a_random_secret_string"

# 3. Canonical Base URL
NEXT_PUBLIC_SITE_URL="https://yourdomain.com"

# 4. Contact Form Email Delivery (Optional)
# Configure SMTP credentials if using dynamic email notifications
MAIL_USER=""
MAIL_PASS=""
MAIL_TO=""
