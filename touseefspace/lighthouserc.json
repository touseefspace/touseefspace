{
  "ci": {
    "collect": {
      "startServerCommand": "npm run start",
      "startServerReadyPattern": "ready on|started server",
      "startServerReadyTimeout": 45000,
      "url": [
        "http://localhost:3000/",
        "http://localhost:3000/projects",
        "http://localhost:3000/projects/wholesale-distribution-erp-platform",
        "http://localhost:3000/skills",
        "http://localhost:3000/experiences",
        "http://localhost:3000/blog",
        "http://localhost:3000/contact"
      ],
      "numberOfRuns": 1,
      "settings": {
        "preset": "desktop",
        "chromeFlags": "--no-sandbox --headless=new --disable-gpu --disable-dev-shm-usage"
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
